# Daraja API credentials (from Safaricom Developer Portal)
DARAJA_CONSUMER_KEY=your_consumer_key
DARAJA_CONSUMER_SECRET=your_consumer_secret

# Passkey for STK Push (from Safaricom)
DARAJA_PASSKEY=your_passkey

# Shortcode / Till Number
DARAJA_SHORTCODE=174379

# Callback URL — must be publicly accessible for M-Pesa to reach it
# Use ngrok for local testing: ngrok http 3001
CALLBACK_URL=https://your-ngrok-url.ngrok.io/api/mpesa/callback

# Server
PORT=3001
